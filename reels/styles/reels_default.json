{
  "id": "reels_default",
  "description": "Default reels subtitle style",
  "engine": "ass",
  "video": {
    "aspect_ratio": "9:16",
    "resolution": [1080, 1920],
    "fps": 30
  },
  "frame": {
    "mode": "square_center",
    "background": "blur",
    "blur": 12
  },
  "subtitles": {
    "enabled": true,
    "layout": {
      "alignment": 5,
      "margin_v": 0,
      "margin_h": 0,
      "max_lines": 2,
      "max_chars_per_line": 18
    },
    "base_style": {
      "font": "Pretendard Black",
      "size": 56,
      "color": "&H00DADADA",
      "outline_color": "&H00000000",
      "shadow_color": "&H64000000",
      "outline": 3,
      "shadow": 2,
      "bold": true,
      "italic": false
    },
    "highlight": {
      "enabled": true,
      "mode": "karaoke",
      "active_color": "&H007AC7F5",
      "inactive_color": "&H00DADADA",
      "word_split": "whitespace",
      "stopwords": ["i", "the", "a", "to", "an", "of", "in", "on", "and", "or", "but"],
      "meaning_weight": 1.25,
      "stopword_weight": 0.6,
      "length_weight": 0.06,
      "min_word_duration": 0.08,
      "max_word_duration": 0.2
    },
    "animation": {
      "entry": "none",
      "exit": "none"
    }
  },
  "overlays": {
    "title": {
      "alignment": 8,
      "margin_v": 60,
      "padding": 6,
      "font": "Pretendard Black",
      "size": 52,
      "color": "&H00FFFFFF",
      "outline": 3,
      "shadow": 2,
      "duration_ms": 3500
    },
    "tagline": {
      "alignment": 2,
      "margin_v": 60,
      "padding": 12,
      "font": "Pretendard Black",
      "size": 72,
      "color": "&H00FFFFFF",
      "outline": 3,
      "shadow": 2,
      "duration_ms": 3500
    }
  }
}
